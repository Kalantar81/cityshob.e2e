{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "cypress",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@common": [
        "cypress/support/modules/common/index.ts"
      ],
      "@map": [
        "cypress/support/modules/map/index.ts"
      ],
      "@video": [
        "cypress/support/modules/video/index.ts"
      ],
      "@events": [
        "cypress/support/modules/events/index.ts"
      ]
    }
  },
  "include": [
    "cypress/**/*.ts",
    "cypress.config.ts"
  ]
}
